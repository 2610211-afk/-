const form = document.querySelector("#concern-form");
const concernInput = document.querySelector("#concern");
const chat = document.querySelector("#chat");
const moodButtons = document.querySelectorAll("[data-mood]");
const statusText = document.querySelector("#status");

let selectedMood = "";

moodButtons.forEach((button) => {
  button.addEventListener("click", () => {
    selectedMood = button.dataset.mood || "";
    moodButtons.forEach((item) => item.classList.toggle("selected", item === button));
  });
});

function addMessage(text, role) {
  if (!chat) return;
  const message = document.createElement("div");
  message.className = `message ${role}`;
  message.textContent = text;
  chat.appendChild(message);
  chat.scrollTop = chat.scrollHeight;
}

if (form && concernInput) {
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const concern = concernInput.value.trim();
    if (!concern) {
      concernInput.focus();
      return;
    }

    addMessage(concern, "user");
    concernInput.value = "";
    if (statusText) statusText.textContent = "답변을 준비하고 있어요…";

    try {
      const response = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ concern, mood: selectedMood })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "응답을 가져오지 못했어요.");
      addMessage(data.reply || "지금 이야기해 줘서 고마워요. 혼자 감당하지 않아도 돼요.", "assistant");
    } catch (error) {
      addMessage("지금은 답변 연결이 원활하지 않아요. 그래도 네 고민은 중요해요. 믿을 만한 어른이나 상담자에게 이야기해 봐도 좋아요.", "assistant");
      console.error(error);
    } finally {
      if (statusText) statusText.textContent = "";
    }
  });
}

// Share the public website URL as a QR code if the page includes the QR area.
// The QR is useful only after this site has been deployed to a public URL.
const qrButton = document.querySelector("#make-qr");
const qrArea = document.querySelector("#qr-code");
if (qrButton && qrArea) {
  qrButton.addEventListener("click", () => {
    if (typeof QRCode === "undefined") {
      qrArea.textContent = "QR 라이브러리를 불러오지 못했어요.";
      return;
    }
    qrArea.innerHTML = "";
    new QRCode(qrArea, {
      text: window.location.href,
      width: 180,
      height: 180
    });
  });
}
